# ============================================
# LoginFlow SDK - environment variables of ONE API
# ============================================
# Copy this file to .env and adjust the values. Each API of a product has its own audience
# and its own machine key.

# --------------------------------------------
# REQUIRED (read by LoginFlowConfig::from_env)
# --------------------------------------------

# LoginFlow base URL, without /v1 (dev: https://api-dev.loginflow.dev)
LOGINFLOW_URL=https://api.loginflow.dev

# Your company id in LoginFlow: every access token's `company_id` must equal it
LOGINFLOW_COMPANY=CP-your-company

# The audience of THIS API (the `aud` of the access tokens it accepts), as the LoginFlow
# panel shows it. Never the issuer. An API created before APIs existed keeps the
# application id (APP-...) as its audience.
LOGINFLOW_API=https://api.your-product.example

# Expected token issuer (dev: https://api-dev.loginflow.dev)
LOGINFLOW_ISSUER=https://api.loginflow.dev

# --------------------------------------------
# THE API'S MACHINE KEY (read by your code, passed to the service clients and to the
# IntrospectionClient of the TokenVerifier; not part of LoginFlowConfig)
# --------------------------------------------

# LOGINFLOW_CLIENT_ID=your-api-key
# LOGINFLOW_CLIENT_SECRET=shown-once-by-the-panel

# --------------------------------------------
# OPTIONAL
# --------------------------------------------

# API version (default: 1)
LOGINFLOW_VERSION=1

# Request timeout in seconds (default: 30)
LOGINFLOW_TIMEOUT=30

# JWKS endpoint (default: {LOGINFLOW_URL}/oauth2/jwks)
# LOGINFLOW_JWKS_URL=https://api.loginflow.dev/oauth2/jwks

# JWKS cache lifetime in seconds (default: 600)
# LOGINFLOW_JWKS_CACHE_TTL_SECS=600

# Custom User-Agent (optional)
# LOGINFLOW_USER_AGENT=MyApp/1.0

# Public base URL of this API, the base of a DPoP proof's expected `htu`
# (default: derived from the request; set it behind a reverse proxy)
# LOGINFLOW_RESOURCE_BASE_URL=https://api.your-product.example
