# ============================================
# LoginFlow SDK - environment variables
# ============================================
# Copy this file to .env and adjust the values.

# --------------------------------------------
# REQUIRED
# --------------------------------------------

# LoginFlow base URL (without /v1)
LOGINFLOW_URL=https://api.loginflow.dev

# Your company UUID in LoginFlow
LOGINFLOW_COMPANY=your-company-uuid

# Your application UUID in LoginFlow (expected `aud` of access tokens)
LOGINFLOW_APPLICATION=your-application-uuid

# Expected token issuer (dev: https://api-dev.loginflow.dev)
LOGINFLOW_ISSUER=https://api.loginflow.dev

# --------------------------------------------
# OPTIONAL
# --------------------------------------------

# API version (default: 1)
LOGINFLOW_VERSION=1

# Request timeout in seconds (default: 30)
LOGINFLOW_TIMEOUT=30

# JWKS endpoint (default: {LOGINFLOW_URL}/oauth2/jwks)
# LOGINFLOW_JWKS_URL=https://api.loginflow.dev/oauth2/jwks

# JWKS cache lifetime in seconds (default: 600)
# LOGINFLOW_JWKS_CACHE_TTL_SECS=600

# Custom User-Agent (optional)
# LOGINFLOW_USER_AGENT=MyApp/1.0
