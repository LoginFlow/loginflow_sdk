# ============================================
# LoginFlow SDK - Variables de Entorno
# ============================================
# Copia este archivo a .env y ajusta los valores

# --------------------------------------------
# REQUERIDAS
# --------------------------------------------

# URL base de LoginFlow (sin /v1)
LOGINFLOW_URL=https://your-loginflow-server.com

# UUID de tu Company en LoginFlow
LOGINFLOW_COMPANY=tu-company-uuid-aqui

# UUID de tu Application en LoginFlow
LOGINFLOW_APPLICATION=tu-application-uuid-aqui

# --------------------------------------------
# OPCIONALES
# --------------------------------------------

# Versión de la API (default: 1)
LOGINFLOW_VERSION=1

# Timeout en segundos (default: 30)
LOGINFLOW_TIMEOUT=30

# User-Agent personalizado (opcional)
# LOGINFLOW_USER_AGENT=MiApp/1.0
